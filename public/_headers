# Cloudflare Pages header rules. Ignored by other hosts, so it is safe to keep.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  # Everything is served from this origin: no external fonts, scripts or trackers.
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; form-action 'none'; base-uri 'self'; frame-ancestors 'none'

# Fingerprinted build output can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
